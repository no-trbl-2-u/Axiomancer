# Copy this file to .env and fill in the values.
# .env is gitignored; never commit it.

# ============================================================
# NOTIFICATIONS — how the loop pages you when blocked
# ============================================================

# scripts/notify.mjs fires on failure-mode stops and unclean turn
# ends. Configure at
# least one channel before an unattended window — see
# playbooks/hands-off.md Step 2. Best-effort: never blocks.
#
# ntfy.sh: free, no signup. Invent a long random topic, then
# subscribe to ntfy.sh/<topic> in the phone app. The topic
# name IS the credential — treat it like one.
# NOTIFY_NTFY_TOPIC=<long-random-topic>
#
# Or any JSON webhook (Slack incoming / Discord / custom):
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================================
# DEPLOY GATE — pick a provider, set DEPLOY_PROVIDER
# ============================================================

# Axiomancer deploy gate = CI-green (GitHub Actions). There is no
# push-to-production; "deploy" means HEAD's path-filtered verify-*
# workflows went green. This is the default — no need to set it.
DEPLOY_PROVIDER=github-actions

# --- GITHUB ACTIONS (Axiomancer default) --------------------
# Uses GH_TOKEN below (Actions:read). Repo defaults to GH_REPO below.
# Workflows polled (override only if you rename them):
# DEPLOY_WORKFLOWS=verify-mechanics.yml,verify-mobile.yml
# Commits whose paths trigger NO verify-* workflow (docs/plan-only ticks)
# exit 0 after this grace window (ms):
# CI_INGEST_GRACE_MS=120000

# --- OTHER PROVIDERS (unused here; kept for reference) ------
# DEPLOY_PROVIDER=netlify | vercel | health-check | none
# NETLIFY_AUTH_TOKEN=nfp_...  NETLIFY_SITE_NAME=...
# VERCEL_TOKEN=...  VERCEL_PROJECT_ID=prj_...  VERCEL_TEAM_ID=team_...
# HEALTH_CHECK_URL=...  HEALTH_CHECK_EXPECT=200  DEPLOY_WAIT_BUFFER_S=120

# ============================================================
# GITHUB — issue mirror + triage (loop-issue.mjs + /triage)
# ============================================================

# Repo-scoped PAT used by:
#   - scripts/loop-issue.mjs (the autonomous-loop issue mirror)
#   - skills/triage.md (inbound user-issue review)
#   - skills/iterate.md Step 2.5 (per-finding mirror)
#   - skills/ship-a-phase.md Step 2.5 + plan-a-phase.md Step 5.5
#     (per-phase mirror — phase-open opens at start, phase-close
#      posts the deploy URL after green deploy; the commit's
#      `Closes #N` trailer auto-closes on push)
#
# `gh` CLI auto-reads GH_TOKEN.
# Needs: Issues read+write, Metadata read.
# Get one at: https://github.com/settings/tokens
# GH_TOKEN=github_pat_...

# Repo slug for /triage and the loop mirror. Defaults to no-trbl-2-u/Axiomancer.
# Override if running the loop against a fork.
# GH_REPO=no-trbl-2-u/Axiomancer

# ============================================================
# ART GENERATION — the ruled Option A route (build-plan phase 73)
# ============================================================

# `scripts/generate-art.mjs` runs the compile -> generate -> ingest path.
# ABSENT THIS KEY the generate leg is INERT by design (T's ruling,
# plan/ideas/AI_ART_PIPELINE_OPTIONS.md §9): the prompt still compiles,
# the request is printed, and the acquisition/post-process legs still
# run. Nothing fails. Set it only when you accept the per-image spend.
# The loop must never commit this value.
# OPENAI_API_KEY=sk-...

# The model is configuration, not a constant — a swappable adapter that
# pins its own model is not swappable. T's ruling names gpt-image-2.
# ART_MODEL=gpt-image-2

# Backend selection: openai (default) | null. `null` forces the inert
# path even with a key present, which is how you review a prompt without
# spending. An unknown value fails loudly rather than falling back.
# ART_BACKEND=openai

# Requested generation size, before the post-process resize to <=640px.
# ART_SIZE=1024x1024

# ============================================================
# KB-QUERY MCP — the external prior-art corpus (docs/external-architecture.md)
# ============================================================

# `.mcp.json` sends `Authorization: Bearer ${KB_MCP_TOKEN}`. Claude Code
# expands it from the PROCESS environment and does not read this file, so
# export it in your shell profile (or the CI secret) as well. Without it the
# kb-query server answers a silent 401 and every prior-art claim is
# UNGROUNDED. Never commit the value.
# KB_MCP_TOKEN=...
