# DevLog — generated site output (Cloudflare Pages serves what `main`'s tree
# contains, and this content was never meant to be public — phase 57,
# plan/phases/phase_57_devlog_pages_scopedown.md). Rebuild locally with
# `npm run site:build`; source inputs (entries/*.md, dated screenshots,
# hand-authored tuning-lab reports, README.md) stay tracked.
devlog/index.html
devlog/log.html
devlog/catalog.html
devlog/entries/*.html
devlog/tuning-lab/index.html
devlog/data/
devlog/assets/catalog/

# DevLog — the PUBLIC site's build output (2026-09-20). Published at deploy
# time by `npm run devlog:public`, from this directory, and never committed:
# phase 57's guard covers it too (scripts/check-devlog-not-served.mjs).
dist/
.playwright-mcp

# Telemetry hook sidecar (pairs *-end rows with their start rows)
.claude/hooks/.telemetry-state.json
