# Copy this file to .env and fill in the values.
# .env is gitignored; never commit it.

# ============================================================
# DEPLOY GATE — EAS Build polling (implemented in phase 11)
# ============================================================

# Provider for scripts/deploy-check.mjs. Set to `eas` to enable
# real EAS Build polling, or `none` for stub (exits 0).
#
# Supported: eas | none
# DEPLOY_PROVIDER=eas

# --- EAS BUILD (Expo) ----------------------------------------
# Token: https://expo.dev/settings/access-tokens
#   Required scopes: builds:read, projects:read
#   See setup/02_eas.md for detailed configuration steps.
# EXPO_TOKEN=your_expo_access_token_here
#
# Project ID: run `eas project:info` in this repo's root, or
# read it from app.json's `expo.extra.eas.projectId`.
# Note: EAS_PROJECT_ID is optional - EAS CLI auto-detects from project config.
# EAS_PROJECT_ID=your_project_id_here

# ============================================================
# GITHUB — issue management
# ============================================================

# Repo-scoped PAT for GitHub issue scripts.
# `gh` CLI auto-reads GH_TOKEN.
# Needs: Issues read+write, Metadata read.
# Get one at: https://github.com/settings/tokens
# GH_TOKEN=github_pat_...

# Repo slug. Defaults to no-trbl-2-u/Axiomancer (the monorepo).
# Override if running against a fork.
# GH_REPO=no-trbl-2-u/Axiomancer
