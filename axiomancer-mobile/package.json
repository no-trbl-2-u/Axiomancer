{
  "name": "axiomancer-mobile",
  "main": "expo-router/entry",
  "version": "1.9.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "_engineNotes": "Dev container (scripts/dev-server-container.sh) uses node:20-alpine for consistency. Local dev accepts any Node >=20.0.0.",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:container": "./scripts/dev-server-container.sh up",
    "web:container:wait": "./scripts/dev-server-container.sh wait",
    "web:container:down": "./scripts/dev-server-container.sh down",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "npm run lint && npm run typecheck && npm test",
    "verify:visual": "node scripts/smoke-screens.mjs",
    "e2e:hazard": "node scripts/hazard-e2e.mjs",
    "e2e:combat": "node scripts/combat-encounter-e2e.mjs",
    "e2e:gathering": "node scripts/gathering-e2e.mjs",
    "e2e:encounters": "node scripts/encounter-routing-e2e.mjs",
    "e2e:theme": "node scripts/theme-switch-e2e.mjs",
    "e2e:loot": "node scripts/loot-rarity-e2e.mjs",
    "e2e:minigames": "node scripts/hazard-e2e.mjs && COMBAT_E2E_REUSE_EXPORT=1 node scripts/combat-encounter-e2e.mjs && GATHER_E2E_REUSE_EXPORT=1 node scripts/gathering-e2e.mjs && ENCOUNTER_E2E_REUSE_EXPORT=1 node scripts/encounter-routing-e2e.mjs",
    "smoke:bundler": "node scripts/smoke-bundler.mjs",
    "baseline:approve": "node scripts/baseline-approve.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy": "npm run deploy:preview",
    "deploy:preview": "npm run verify && node scripts/with-env.mjs eas build --platform android --profile preview",
    "deploy:production": "npm run verify && node scripts/with-env.mjs eas build --platform all --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/im-fell-english": "^0.4.0",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/pirata-one": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axiomancer-mechanics": "^0.37.0",
    "dotenv": "^17.4.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
