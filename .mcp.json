{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--headless",
        "--isolated"
      ]
    },
    "kb-query": {
      "type": "http",
      "url": "https://kb-mcp.no-trbl-2-u.workers.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${KB_MCP_TOKEN}"
      }
    },
    "axio-query": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/axio-mcp-server.mjs"
      ]
    }
  }
}
