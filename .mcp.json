{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--headless",
        "--isolated"
      ]
    },
    "kb-query": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/kb-mcp-launcher.mjs"
      ]
    },
    "axio-query": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/axio-mcp-server.mjs"
      ]
    }
  }
}
