{
  "__note": "Nexus enforcement layer (OPT-IN). Copy to .claude/settings.json to activate: a permission allowlist so unattended /loop ticks never stall on a prompt, deny walls for force-push / --no-verify / destructive resets, and guard hooks (.claude/hooks/guard.mjs) that block the forbidden commands at the harness + warn on unclean turn-ends. Only needed at intervention level 3+ (unattended). At level 0-2 (manual /ship-a-phase, attended /march) it is unnecessary. Activating it widens the agent's own grants, so it is a deliberate, user-owned step — the adoption did not enable it for you. Delete this __note key after copying.",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(git pull --ff-only:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run deploy:check:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npm run game:*)",
      "Bash(npm run combat-sim:*)",
      "Bash(npm run combat-playtest:*)",
      "Bash(npm ci)",
      "Bash(node scripts/deploy-check.mjs:*)",
      "Bash(node scripts/notify.mjs:*)",
      "Bash(node scripts/loop-issue.mjs:*)",
      "Bash(node .claude/hooks/guard.mjs:*)",
      "Bash(gh auth status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh label create:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(awk:*)",
      "Bash(mktemp:*)",
      "Bash(echo:*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(date:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs pre-bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.mjs stop"
          }
        ]
      }
    ]
  }
}
