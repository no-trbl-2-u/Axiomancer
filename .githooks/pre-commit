#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# TELEMETRY.md is generated residue, but it belongs to the code change that
# produced it. Always stage its current state with any commit.
if [ -n "$(git status --porcelain -- TELEMETRY.md)" ]; then
  git add -A -- TELEMETRY.md
  printf '%s\n' 'pre-commit: staged TELEMETRY.md alongside this commit.' >&2
fi

# Retired terminology is cheapest to reject before it reaches a hosted runner.
# Active package workflows run the same check remotely; this hook protects
# documentation-only commits between the weekly remote backstops.
if git diff --cached --name-only --diff-filter=ACMR \
  | grep -Eq '(\.md$|^axiomancer-mechanics/docs/lexicon\.json$|^scripts/check-lexicon\.mjs$)'; then
  node scripts/check-lexicon.mjs
fi

# Cloudflare Pages serves whatever `main`'s tree contains. The DevLog's
# generated HTML/data/art must never re-enter the index — check it whenever
# a staged change touches devlog/ (phase 57).
if git diff --cached --name-only --diff-filter=ACMR \
  | grep -q '^devlog/'; then
  node scripts/check-devlog-not-served.mjs
fi
