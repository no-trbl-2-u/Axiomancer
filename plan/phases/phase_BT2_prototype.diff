+// THROWAWAY prototype switch for the BT2 layout exploration (2026-10-13).
+// Set `localStorage.axmLayout` to 'A' | 'B' | 'mix' on the web build and reload.
+export type LayoutProto = 'current' | 'A' | 'B' | 'mix';
+
+export function layoutProto(): LayoutProto {
+    try {
+        const v = (globalThis as { localStorage?: Storage }).localStorage?.getItem('axmLayout');
+        if (v === 'A' || v === 'B' || v === 'mix') return v;
+    } catch { /* native / no storage */ }
+    return 'current';
+}
+
+export type BadgeProto = 'free-only' | 'free-both' | 'paid' | 'split' | 'v5';
+
+export function badgeProto(): BadgeProto {
+    try {
+        const v = (globalThis as { localStorage?: Storage }).localStorage?.getItem('axmBadge');
+        if (v === 'free-only' || v === 'paid' || v === 'split' || v === 'free-both') return v;
+    } catch { /* native / no storage */ }
+    return 'v5';
+}
